# Optional — enables LIVE worldwide search via the Google Places API (New).
# Without a key the site runs on the bundled demo dataset.
#
# Get a key: https://console.cloud.google.com/apis/credentials
# Enable: "Places API (New)" on the key's project.
GOOGLE_PLACES_API_KEY=

# Required to log into /admin and approve/reject community-submitted venues.
# Pick any strong password.
ADMIN_PASSWORD=

# Optional but recommended — persistent storage for community submissions
# (Upstash Redis REST API). Without these, submissions are kept in memory
# and are lost on every server restart/redeploy.
#
# Easiest setup: in your Vercel project, Storage tab -> add the
# "Upstash for Redis" integration -> these two vars are injected automatically.
# Or create a free database directly at https://console.upstash.com.
KV_REST_API_URL=
KV_REST_API_TOKEN=
