# Optional — enables LIVE worldwide search via the Google Places API (New).
# Without a key the site runs on the bundled demo dataset.
#
# Get a key: https://console.cloud.google.com/apis/credentials
# Enable: "Places API (New)" on the key's project.
GOOGLE_PLACES_API_KEY=

# Required to log into /admin and approve/reject community-submitted venues.
# Pick any strong password.
ADMIN_PASSWORD=

# Recommended — persistent storage for community submissions, backed by a
# real Postgres database. Without this (or the Redis fallback below),
# submissions are kept in server memory and are lost on every
# restart/redeploy.
#
# Setup: create a free project at https://supabase.com, run
# supabase/schema.sql in its SQL Editor, then copy these from
# Project Settings -> API. SUPABASE_SERVICE_ROLE_KEY is a secret — it's only
# ever used server-side (never sent to the browser) and bypasses Row Level
# Security, so keep it out of client code and version control.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Alternative persistent storage (Upstash Redis REST API), used only if the
# Supabase vars above are not set. Easiest setup: in your Vercel project,
# Storage tab -> add the "Upstash for Redis" integration -> these two vars
# are injected automatically. Or create a free database directly at
# https://console.upstash.com.
KV_REST_API_URL=
KV_REST_API_TOKEN=
